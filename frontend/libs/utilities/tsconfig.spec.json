{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@core": ["frontend/libs/core/src"]
		}
	},
	"include": [
		"vitest.config.ts",
		"vitest.config.ts",
		"vitest.config.ts",
		"vitest.config.mts",
		"src/**/*.test.ts",
		"src/**/*.spec.ts",
		"src/**/*.test.tsx",
		"src/**/*.spec.tsx",
		"src/**/*.test.js",
		"src/**/*.spec.js",
		"src/**/*.test.jsx",
		"src/**/*.spec.jsx",
		"src/**/*.d.ts"
	]
}
