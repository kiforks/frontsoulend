{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@core": ["frontend/libs/core/src"],
			"@utilities": ["frontend/libs/utilities/src"]
		},
		"moduleResolution": "bundler"
	},
	"exclude": [
		"src/**/*.spec.ts",
		"src/**/*.test.ts",
		"**/*.stories.ts",
		"**/*.stories.js",
		"vitest.config.ts",
		"vitest.environment.ts"
	],
	"include": ["src/**/*.ts"]
}
