{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"paths": {
			"@core": ["libs/core/src"],
			"@utilities": ["libs/utilities/src"]
		}
	},
	"include": [
		"vitest.config.ts",
		"vitest.config.mts",
		"src/**/*.spec.ts",
		"src/**/*.test.ts",
		"src/**/*.d.ts",
		"tests/**/*.spec.ts",
		"tests/**/*.test.ts"
	],
	"files": ["vitest.environment.ts"]
}
