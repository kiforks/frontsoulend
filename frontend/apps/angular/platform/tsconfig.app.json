{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist/out-tsc",
		"types": [],
		"moduleResolution": "bundler"
	},
	"files": ["src/app/main.ts", "src/app/polyfills.ts"],
	"include": ["src/**/*.d.ts"],
	"exclude": [
		"src/**/*.test.ts",
		"src/**/*.spec.ts",
		"vitest.config.ts",
		"vitest.config.ts",
		"vitest.config.ts",
		"vitest.config.mts",
		"src/**/*.test.tsx",
		"src/**/*.spec.tsx",
		"src/**/*.test.js",
		"src/**/*.spec.js",
		"src/**/*.test.jsx",
		"src/**/*.spec.jsx",
		"vitest.environment.ts"
	]
}
