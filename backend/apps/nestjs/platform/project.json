{
	"name": "backend/apps/nestjs/platform",
	"$schema": "../../../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "backend/apps/nestjs/platform/src",
	"projectType": "application",
	"tags": ["backend", "scope:app"],
	"targets": {
		"build": {
			"executor": "@nx/esbuild:esbuild",
			"outputs": ["{options.outputPath}"],
			"defaultConfiguration": "development",
			"options": {
				"main": "backend/apps/nestjs/platform/src/app/main.ts",
				"outputPath": "dist/backend/apps/nestjs/platform",
				"outputFileName": "main.js",
				"tsConfig": "backend/apps/nestjs/platform/tsconfig.app.json",
				"platform": "node",
				"format": ["esm"],
				"assets": []
			},
			"configurations": {
				"development": {
					"minify": false
				},
				"production": {
					"minify": true
				}
			}
		},
		"serve": {
			"continuous": true,
			"executor": "@nx/js:node",
			"defaultConfiguration": "development",
			"dependsOn": ["build"],
			"options": {
				"buildTarget": "backend/apps/nestjs/platform:build",
				"runBuildTargetDependencies": false
			},
			"configurations": {
				"development": {
					"buildTarget": "backend/apps/nestjs/platform:build:development"
				},
				"production": {
					"buildTarget": "backend/apps/nestjs/platform:build:production"
				}
			}
		},
		"test": {
			"executor": "@nx/jest:jest",
			"outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
			"options": {
				"jestConfig": "backend/apps/nestjs/platform/jest.config.ts"
			}
		}
	}
}
