{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "./dist/out-tsc",
		"module": "ESNext",
		"target": "ESNext",
		"types": ["vitest/globals", "vitest/importMeta", "vite/client", "node", "vitest"],
		"paths": {
			"@core": ["libs/core/src"],
			"@utilities": ["libs/utilities/src"]
		}
	},
	"include": [
		"vitest.config.ts",
		"vitest.config.ts",
		"vitest.config.ts",
		"vitest.config.mts",
		"src/**/*.test.ts",
		"src/**/*.spec.ts",
		"src/**/*.d.ts"
	]
}
