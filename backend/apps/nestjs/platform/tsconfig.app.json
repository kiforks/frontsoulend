{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"types": ["node"],
		"module": "ESNext",
		"paths": {
			"~prisma/*": ["backend/prisma/client/*"],
			"@libs/nestjs/environment/*": ["backend/libs/nestjs/environment/*"]
		}
	},
	"include": ["src/**/*.ts"],
	"exclude": ["jest.config.ts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
